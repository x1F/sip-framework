{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "transitiveRemediation": true
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch dependencies"
    }
  ]
}
